{
  "name": "thai-document-generator",
  "version": "1.0.0",
  "description": "Generate Thai-language PDF documents (invoices and reports) with correct Thai typography.",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "samples": "node dist/cli/renderSamples.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "express": "^4.21.0",
    "handlebars": "^4.7.8",
    "puppeteer": "23.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "unpdf": "^0.12.1",
    "vitest": "^2.1.1"
  }
}
